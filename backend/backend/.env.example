# =================================================================
# MindSetu FastAPI Backend Environment Configuration
# =================================================================

# 1. Database Connection (PostgreSQL / Supabase)
# For Supabase / Render PostgreSQL, use:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Leave as sqlite:///./mindsetu.db for offline local testing:
DATABASE_URL=sqlite:///./mindsetu.db

# 2. Supabase API Credentials (Optional / for direct client SDK use)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# 3. JWT Security (Change to a strong random key in production)
JWT_SECRET_KEY=mindsetu-sih-2026-secure-development-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 4. Application Configuration
PROJECT_NAME="MindSetu Backend"
API_V1_STR="/api/v1"
ENVIRONMENT=production

# 5. CORS Configuration (Comma-separated list or JSON array of allowed frontend URLs)
# Add your deployed Flutter Web URL here (e.g. Render, Vercel, Firebase):
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://mindsetu.onrender.com,https://mindsetu.vercel.app
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# 6. Groq Conversational AI & STT (Server-Side Only - Never commit real key)
GROQ_API_KEY=your-groq-api-key-here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1
